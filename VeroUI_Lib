-- ══════════════════════════════════════════
-- § HELPERS
-- ══════════════════════════════════════════
local function make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(parent, radius)
	return make("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, parent)
end

local function stroke(parent, color, thickness)
	return make("UIStroke", {
		Color = color, Thickness = thickness or 0.5,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function padding(parent, l, r, t, b)
	return make("UIPadding", {
		PaddingLeft   = UDim.new(0, l or 0),
		PaddingRight  = UDim.new(0, r or 0),
		PaddingTop    = UDim.new(0, t or 0),
		PaddingBottom = UDim.new(0, b or 0),
	}, parent)
end

local function listLayout(parent, dir, pad)
	return make("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder     = Enum.SortOrder.LayoutOrder,
		Padding       = UDim.new(0, pad or 0),
	}, parent)
end

local function addHover(frame, normalColor, hoverColor)
	frame.MouseEnter:Connect(function()
		tween(frame, TW_FAST, { BackgroundColor3 = hoverColor })
	end)
	frame.MouseLeave:Connect(function()
		tween(frame, TW_FAST, { BackgroundColor3 = normalColor })
	end)
end

-- ══════════════════════════════════════════
-- § TAB  (component builders live here)
-- ══════════════════════════════════════════
local Tab = {}
Tab.__index = Tab

function Tab:_order()
	self._layoutOrder = (self._layoutOrder or 0) + 1
	return self._layoutOrder
end

-- Internal: creates a themed row frame inside the ContentFrame.
-- height is in pixels and used for fixed-height rows; scale values
-- inside rows are relative to this row's size.
function Tab:_row(height)
	local T   = self._window.Theme
	local row = make("Frame", {
		Size             = UDim2.new(1, 0, 0, height or 44),
		BackgroundColor3 = T.RowBg,
		BorderSizePixel  = 0,
		ZIndex           = 4,
		LayoutOrder      = self:_order(),
	}, self.ContentFrame)
	corner(row, 8)
	stroke(row, T.RowBorder)
	addHover(row, T.RowBg, T.RowHover)
	table.insert(self._rows, { frame = row, type = "row" })
	return row
end

-- AddSection(title)
-- Uppercase label divider
function Tab:AddSection(title)
	local T   = self._window.Theme
	local lbl = make("TextLabel", {
		Size                 = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text                 = title:upper(),
		TextColor3           = T.SectionTitle,
		Font                 = Enum.Font.GothamMedium,
		TextSize             = 10,
		TextXAlignment       = Enum.TextXAlignment.Left,
		ZIndex               = 4,
		LayoutOrder          = self:_order(),
	}, self.ContentFrame)
	table.insert(self._rows, { frame = lbl, type = "section" })
end

-- AddSeparator()
-- Thin horizontal rule
function Tab:AddSeparator()
	local T   = self._window.Theme
	local sep = make("Frame", {
		Size             = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = T.RowBorder,
		BorderSizePixel  = 0,
		ZIndex           = 4,
		LayoutOrder      = self:_order(),
	}, self.ContentFrame)
	corner(sep, 1)
	table.insert(self._rows, { frame = sep, type = "separator" })
end

-- AddToggle(name, desc, default, callback)
-- callback(bool) → returns { SetValue, GetValue }
function Tab:AddToggle(name, desc, default, callback)
	local T     = self._window.Theme
	local value = default or false
	local row   = self:_row(44)

	make("TextLabel", {
		Size = UDim2.new(0.75, 0, 0, 16), Position = UDim2.new(0.03, 0, 0, 8),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
