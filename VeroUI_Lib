--
-- SETUP
--   1. Place VeroLib.lua inside ReplicatedStorage
--   2. Create a LocalScript inside StarterPlayerScripts
--   3. Require and build your UI:
--
--        local VeroLib = require(game.ReplicatedStorage.VeroLib)
--        local window  = VeroLib.new("DarkGrey")
--        window:BindToggleKey(Enum.KeyCode.RightShift)
--
--        local player = window:AddTab("player")
--        player:AddSection("movement")
--        player:AddToggle("god mode", "infinite health", false, function(v) end)
--        player:AddSlider("walk speed", 16, 100, 16, function(v)
--            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = v
--        end)
--        window:SetStatus("ready")
--
-- ──────────────────────────────────────────────────────────────
-- WINDOW API
-- ──────────────────────────────────────────────────────────────
--   VeroLib.new(themeName?)          Create and show the window
--   window:AddTab(name)              Add a tab → returns Tab object
--   window:SetStatus(text)           Update the status bar text
--   window:SetTheme(themeName)       Swap theme at runtime
--   window:BindToggleKey(keyCode?)   Bind show/hide key (default: RightShift)
--   window:Expand(panelHeight)       Open panel to a pixel height  [internal]
--   window:Collapse()                Close the panel               [internal]
--
-- ──────────────────────────────────────────────────────────────
-- TAB BUILDERS  (call on the object returned by AddTab)
-- ──────────────────────────────────────────────────────────────
--   tab:AddSection(title)
--       Uppercase label divider — no return value
--
--   tab:AddSeparator()
--       Thin horizontal rule — no return value
--
--   tab:AddToggle(name, desc, default, callback)
--       callback(bool)
--       Returns { SetValue(bool), GetValue() }
--
--   tab:AddSlider(name, min, max, default, callback)
--       callback(number)   Has a reset button back to default
--       Returns { SetValue(n), GetValue(), Reset() }
--
--   tab:AddButton(name, desc, label, callback)
--       callback()
--       No return value
--
--   tab:AddDropdown(name, options, default, callback)
--       options = { "opt1", "opt2", ... }
--       callback(selectedString)
--       Returns { SetValue(str), GetValue() }
--
--   tab:AddKeybind(name, desc, default, callback)
--       default = Enum.KeyCode.X    Click badge to rebind
--       callback(Enum.KeyCode)
--       Returns { GetKey() }
--
--   tab:AddTextInput(name, placeholder, callback)
--       callback(text, enterPressed)
--       Returns { GetValue(), SetValue(str) }
--
--   tab:AddColorPicker(name, desc, swatches, default, callback)
--       swatches = { Color3, Color3, ... }
--       callback(Color3)
--       Returns { GetValue(), SetValue(Color3) }
--
--   tab:AddSearch(placeholder, onChange?)
--       Filters all rows in the tab by text content as user types
--       onChange(query) optional
--       Returns { GetValue(), Clear() }
--
--   tab:AddGameBox(placeId, title, buildFn)
--       buildFn(panel, state) — panel is a full Tab proxy
--       state:get(key, default) / state:set(key, value)
--       State persists across open/close cycles
--       No return value
--
-- ──────────────────────────────────────────────────────────────
-- THEMES  (pass name string to VeroLib.new or window:SetTheme)
-- ──────────────────────────────────────────────────────────────
--   DarkGrey · Midnight · Purple · Ocean · Ember · Matrix
--   Rose · Light · Void · Cyber · NeonPink · Toxic · Blood
--   Gold · Teal · Hazard · Sakura · Ultraviolet · Mint · Solar
--
-- ──────────────────────────────────────────────────────────────
-- RESPONSIVE SCALING
-- ──────────────────────────────────────────────────────────────
--   Change the X scale in VeroLib.new (default 0.285) to resize
--   the bar width. Everything else derives from that value at runtime.
--
-- ──────────────────────────────────────────────────────────────

local VeroLib = {}
VeroLib.__index = VeroLib

