		Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(16, 0),
		BackgroundTransparency = 1, Text = "ready",
		TextColor3 = T.StatusText, Font = Enum.Font.Gotham, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, statusInner)

	make("TextLabel", {
		Size = UDim2.new(0, 40, 1, 0), Position = UDim2.new(1, -40, 0, 0),
		BackgroundTransparency = 1, Text = "vero",
		TextColor3 = T.StatusText, Font = Enum.Font.GothamMedium, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
	}, statusInner)

	-- Drag
	local dragging, dragStart, startPos
	self.Bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging  = true
			dragStart = input.Position
			startPos  = self.Window.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local d = input.Position - dragStart
			self.Window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	self.MinimizeBtn.MouseButton1Click:Connect(function() self:Collapse() end)
	self.CloseBtn.MouseButton1Click:Connect(function() self.ScreenGui:Destroy() end)

	self._settingsBuilt = false
	self.SettingsBtn.MouseButton1Click:Connect(function()
		if not self._settingsBuilt then
			self:_BuildSettingsTab()
			self._settingsBuilt = true
		end
		if self.ActiveTab == self._settingsTab then
			self:Collapse()
		else
			self:_SetActiveTab(self._settingsTab)
		end
	end)

	return self
end

-- ─────────────────────────────────────────
-- _BuildSettingsTab
-- ─────────────────────────────────────────
function VeroLib:_BuildSettingsTab()
	local tab = setmetatable({ _window = self, _layoutOrder = 0, _rows = {} }, Tab)
	tab.Name  = "Settings"

	local contentFrame = make("Frame", {
		Name = "SettingsContent", Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Visible = false, ZIndex = 3,
	}, self.PanelBody)
	listLayout(contentFrame)

	local dummyBtn = make("TextButton", {
		Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1,
		Text = "", Visible = false,
	}, self.Bar)
	tab.Button       = dummyBtn
	tab.Label        = make("TextLabel", {
		Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0),
	}, dummyBtn)
	tab.Underline    = make("Frame", {
		Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = false,
	}, dummyBtn)
	tab.ContentFrame = contentFrame

	table.insert(self.Tabs, tab)
	self._settingsTab = tab

	tab:AddSection("theme")
	local themeMap = {
		{ key = "DarkGrey", label = "dark grey" },
		{ key = "Midnight", label = "midnight"  },
		{ key = "Purple",   label = "purple"    },
	}
	for _, t in ipairs(themeMap) do
		tab:AddButton(t.label, "switch ui theme", "apply", function()
			self:SetTheme(t.key)
			self:SetStatus("theme: " .. t.label)
		end)
	end

	tab:AddSection("keybinds")
	tab:AddKeybind("toggle menu", "show / hide vero", Enum.KeyCode.RightShift, function(key)
		self:BindToggleKey(key)
		self:SetStatus("toggle key: " .. key.Name)
	end)

	tab:AddSection("general")
	tab:AddToggle("always on top", "bar stays above game ui", true, function(v)
		self.ScreenGui.DisplayOrder = v and 10 or 0
	end)
	tab:AddToggle("notifications", "mod status changes", false, function(v)
		self._notificationsEnabled = v
	end)
	tab:AddSeparator()
	tab:AddButton("close vero", "destroy the ui entirely", "close", function()
		self.ScreenGui:Destroy()
	end)
end

-- ─────────────────────────────────────────
-- SetTheme
-- ─────────────────────────────────────────
function VeroLib:SetTheme(themeName)
	local T = Themes[themeName]
	if not T then return end
	self.Theme = T

	-- Top-level surfaces
	self.Window.BackgroundColor3          = T.Background
	self.Bar.BackgroundColor3             = T.Bar
	self.PanelBody.BackgroundColor3       = T.PanelBg
	self.PanelBody.ScrollBarImageColor3   = T.RowBorder
	self.StatusBar.BackgroundColor3  = T.StatusBar
	self.StatusLabel.TextColor3      = T.StatusText
	self.StatusDot.BackgroundColor3  = T.StatusDot
	self._brandLabel.TextColor3      = T.BrandText
	self._outerDiamond.BackgroundColor3 = T.LogoColor
	self._innerDiamond.BackgroundColor3 = T.Bar

	-- End buttons
	for _, b in ipairs(self._endFrame:GetChildren()) do
		if b:IsA("TextButton") then
			b.TextColor3 = T.EndBtn
		end
	end

	-- Window + bar strokes
	local winStroke = self.Window:FindFirstChildOfClass("UIStroke")
	if winStroke then winStroke.Color = T.BarBorder end
	local barStroke = self.Bar:FindFirstChildOfClass("UIStroke")
	if barStroke then barStroke.Color = T.BarBorder end
	local sbStroke = self.StatusBar:FindFirstChildOfClass("UIStroke")
	if sbStroke then sbStroke.Color = T.BarBorder end

	-- Tab buttons
	for _, t in ipairs(self.Tabs) do
		local active = (t == self.ActiveTab)
		t.Button.BackgroundColor3    = active and T.TabActive or T.TabInactive
		t.Label.TextColor3           = active and T.TabText   or T.TabTextMuted
		t.Underline.BackgroundColor3 = T.TabUnderline
		local ts = t.Button:FindFirstChildOfClass("UIStroke")
		if ts then ts.Color = T.BarBorder end
		-- Recolor all row-level components within each tab
		if t.ApplyTheme then
			t:ApplyTheme(T)
		end
	end
end

-- ─────────────────────────────────────────
-- Expand / Collapse  — use actual window width
-- ─────────────────────────────────────────
function VeroLib:Expand(panelHeight)
	local w        = self.Window.Size.X.Offset
	local clamped  = math.min(panelHeight, self.MaxPanelHeight)
	local totalH   = 44 + clamped + 26
	self.PanelBody.Visible = true
	self.StatusBar.Visible = true
	-- Lock panel frame to the clamped height; canvas grows via AutomaticCanvasSize
	self.PanelBody.Size     = UDim2.new(1, 0, 0, clamped)
	self.StatusBar.Position = UDim2.fromOffset(0, 44 + clamped)
	TweenService:Create(self.Window, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
		Size = UDim2.new(0, w, 0, totalH)
	}):Play()
	self.Expanded = true
end

function VeroLib:Collapse()
	local w = self.Window.Size.X.Offset
	TweenService:Create(self.Window, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
		Size = UDim2.new(0, w, 0, 44)
	}):Play()
	task.delay(0.18, function()
		self.PanelBody.Visible = false
		self.StatusBar.Visible = false
	end)
	self.Expanded  = false
	self.ActiveTab = nil
end

-- ─────────────────────────────────────────
-- AddTab
-- ─────────────────────────────────────────
function VeroLib:AddTab(name)
	local T   = self.Theme
	local tab = setmetatable({ _window = self, _layoutOrder = 0, _rows = {} }, Tab)
	tab.Name  = name

	local tabBtn = make("TextButton", {
		Name = name .. "Tab", Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.TabInactive, BorderSizePixel = 0,
		Text = "", ZIndex = 5, LayoutOrder = #self.Tabs + 1,
	}, self.TabContainer)
	stroke(tabBtn, T.BarBorder, 1)
	padding(tabBtn, 16, 16)

	local tabLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = name:lower(), TextColor3 = T.TabTextMuted,
		Font = Enum.Font.Gotham, TextSize = 12, ZIndex = 6,
	}, tabBtn)

	local underline = make("Frame", {
		Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = T.TabUnderline, BorderSizePixel = 0,
		Visible = false, ZIndex = 7,
	}, tabBtn)

	local contentFrame = make("Frame", {
		Name = name .. "Content", Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Visible = false, ZIndex = 3,
	}, self.PanelBody)
	listLayout(contentFrame)

	tab.Button       = tabBtn
	tab.Label        = tabLabel
	tab.Underline    = underline
	tab.ContentFrame = contentFrame

	tabBtn.MouseButton1Click:Connect(function()
		if self.ActiveTab == tab then
			self:Collapse()
			return
		end
		self:_SetActiveTab(tab)
	end)

	table.insert(self.Tabs, tab)
	return tab
end

-- ─────────────────────────────────────────
-- _SetActiveTab
-- ─────────────────────────────────────────
function VeroLib:_SetActiveTab(tab)
	local T = self.Theme
	for _, t in ipairs(self.Tabs) do
		t.Button.BackgroundColor3 = T.TabInactive
		t.Label.TextColor3        = T.TabTextMuted
		t.Label.Font              = Enum.Font.Gotham
		t.Underline.Visible       = false
		t.ContentFrame.Visible    = false
	end
	tab.Button.BackgroundColor3 = T.TabActive
	tab.Label.TextColor3        = T.TabText
	tab.Label.Font              = Enum.Font.GothamMedium
	tab.Underline.Visible       = true
	tab.ContentFrame.Visible    = true
	self.ActiveTab              = tab

	task.defer(function()
		local panelH = tab.ContentFrame.AbsoluteSize.Y + 24
		self:Expand(panelH)
	end)
end

-- ─────────────────────────────────────────
-- SetStatus / BindToggleKey
-- ─────────────────────────────────────────
function VeroLib:SetStatus(text)
	self.StatusLabel.Text = text
end

function VeroLib:BindToggleKey(keyCode)
	keyCode = keyCode or Enum.KeyCode.RightShift
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == keyCode then
			self.ScreenGui.Enabled = not self.ScreenGui.Enabled
		end
	end)
end

return VeroLib
