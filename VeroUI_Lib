			divider.Visible = false
			tween(chevronLabel, TW_FAST, { Rotation = 0 })
		end
	end)

	local entry = self._rows[#self._rows]
	entry.valBadge     = valBadge
	entry.valLabel     = valLabel
	entry.divider      = divider
	entry.optBtns      = optBtns
	entry.getValue     = function() return value end
	entry.chevronLabel = chevronLabel

	local obj = {}
	function obj:SetValue(v)
		value = v
		valLabel.Text = v
		for o, b in pairs(optBtns) do
			tween(b, TW_FAST, {
				BackgroundColor3 = o == v and T.BadgeBg or T.RowBg,
				TextColor3       = o == v and T.TextPrimary or T.TextMuted,
			})
			b.Font = o == v and Enum.Font.GothamMedium or Enum.Font.Gotham
		end
	end
	function obj:GetValue() return value end
	return obj
end

