-- AddToggle
function Tab:AddToggle(name, desc, default, callback)
	local T     = self._window.Theme
	local value = default or false
	local row   = self:_row(44)

	make("TextLabel", {
		Size = UDim2.new(1, -60, 0, 16), Position = UDim2.fromOffset(13, 8),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)
	make("TextLabel", {
		Size = UDim2.new(1, -60, 0, 14), Position = UDim2.fromOffset(13, 24),
		BackgroundTransparency = 1, Text = desc or "", TextColor3 = T.TextMuted,
		Font = Enum.Font.Gotham, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	local pill = make("Frame", {
		Size = UDim2.fromOffset(36, 20), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -13, 0.5, 0),
		BackgroundColor3 = value and T.PillOn or T.PillOff,
		BorderSizePixel = 0, ZIndex = 5,
	}, row)
	corner(pill, 10)
	local pillStroke = stroke(pill, value and T.KnobOn or T.RowBorder)

	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0, 0.5),
		Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = value and T.KnobOn or T.KnobOff,
		BorderSizePixel = 0, ZIndex = 6,
	}, pill)
	corner(knob, 10)

	local tw = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
	local function refresh()
		local t = self._window.Theme
		TweenService:Create(pill, tw, { BackgroundColor3 = value and t.PillOn or t.PillOff }):Play()
		TweenService:Create(knob, tw, {
			BackgroundColor3 = value and t.KnobOn or t.KnobOff,
			Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}):Play()
	end

	make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "", ZIndex = 7,
	}, row).MouseButton1Click:Connect(function()
		value = not value
		refresh()
		if callback then callback(value) end
	end)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.type      = "toggle"
	entry.pill      = pill
	entry.pillStroke = pillStroke
	entry.knob      = knob
	entry.getValue  = function() return value end
	entry.nameLabel = row:FindFirstChild("TextLabel") -- first child
	-- Collect all text labels in this row for recoloring
	entry.rowLabels = row:GetChildren()

	local obj = {}
	function obj:SetValue(v) value = v refresh() end
	function obj:GetValue() return value end
	return obj
end

-- AddSlider
function Tab:AddSlider(name, min, max, default, callback)
	local T     = self._window.Theme
	local value = math.clamp(default or min, min, max)
	local row   = self:_row(54)

	make("TextLabel", {
		Size = UDim2.new(1, -60, 0, 16), Position = UDim2.fromOffset(13, 10),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	local valBadge = make("TextLabel", {
		Size = UDim2.fromOffset(44, 18), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -13, 0, 8),
		BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0,
		Text = tostring(value), TextColor3 = T.BadgeText,
		Font = Enum.Font.GothamMedium, TextSize = 11, ZIndex = 5,
	}, row)
	corner(valBadge, 4)
	stroke(valBadge, T.RowBorder)

	local track = make("Frame", {
		Size = UDim2.new(1, -26, 0, 3), Position = UDim2.new(0, 13, 0, 40),
		BackgroundColor3 = T.SliderTrack, BorderSizePixel = 0, ZIndex = 5,
	}, row)
	corner(track, 2)

	local pct  = (value - min) / (max - min)
	local fill = make("Frame", {
		Size = UDim2.new(pct, 0, 1, 0),
		BackgroundColor3 = T.SliderFill, BorderSizePixel = 0, ZIndex = 6,
	}, track)
	corner(fill, 2)

	local thumb = make("Frame", {
		Size = UDim2.fromOffset(11, 11), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(pct, 0, 0.5, 0),
		BackgroundColor3 = T.KnobOn, BorderSizePixel = 0, ZIndex = 7,
	}, track)
	corner(thumb, 10)

	local function setSlider(v)
		value           = math.clamp(math.round(v), min, max)
		local p         = (value - min) / (max - min)
		fill.Size       = UDim2.new(p, 0, 1, 0)
		thumb.Position  = UDim2.new(p, 0, 0.5, 0)
		valBadge.Text   = tostring(value)
		if callback then callback(value) end
	end

	local dragging = false
	local hitbox = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 13, 0, 32),
		BackgroundTransparency = 1, Text = "", ZIndex = 8,
	}, row)
	hitbox.MouseButton1Down:Connect(function() dragging = true end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setSlider(min + rel * (max - min))
		end
	end)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.type      = "slider"
	entry.valBadge  = valBadge
	entry.track     = track
	entry.fill      = fill
	entry.thumb     = thumb

	local obj = {}
	function obj:SetValue(v) setSlider(v) end
	function obj:GetValue() return value end
	return obj
end

