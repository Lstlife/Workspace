	}, row)

	local pill = make("Frame", {
		Size = UDim2.fromOffset(36, 20), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0.97, 0, 0.5, 0),
		BackgroundColor3 = value and T.PillOn or T.PillOff,
		BorderSizePixel = 0, ZIndex = 5,
	}, row)
	corner(pill, 10)
	local pillStroke = stroke(pill, value and T.KnobOn or T.RowBorder)

	local knob = make("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0, 0.5),
		Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		BackgroundColor3 = value and T.KnobOn or T.KnobOff,
		BorderSizePixel = 0, ZIndex = 6,
