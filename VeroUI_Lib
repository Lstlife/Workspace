-- AddDropdown
function Tab:AddDropdown(name, options, default, callback)
	local T     = self._window.Theme
	local value = default or options[1]
	local open  = false

	local wrapper = make("Frame", {
		Size = UDim2.new(1, 0, 0, 44), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.RowBg, BorderSizePixel = 0,
		ClipsDescendants = true, ZIndex = 4, LayoutOrder = self:_order(),
	}, self.ContentFrame)
	corner(wrapper)
	stroke(wrapper, T.RowBorder)
	table.insert(self._rows, { frame = wrapper, type = "dropdown" })

	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1, ZIndex = 5,
	}, wrapper)

	make("TextLabel", {
		Size = UDim2.new(1, -80, 0, 16), Position = UDim2.fromOffset(13, 14),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	}, header)

	local valBadge = make("Frame", {
		Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -13, 0.5, 0),
		BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0, ZIndex = 6,
	}, header)
	corner(valBadge, 4)
	stroke(valBadge, T.RowBorder)
	padding(valBadge, 8, 8)

	local valLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = value, TextColor3 = T.BadgeText,
		Font = Enum.Font.GothamMedium, TextSize = 11, ZIndex = 7,
	}, valBadge)

	local divider = make("Frame", {
		Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, 44),
		BackgroundColor3 = T.RowBorder, BorderSizePixel = 0, ZIndex = 5,
		Visible = false,
	}, wrapper)

	local optList = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.fromOffset(0, 45),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
		Visible = false,
	}, wrapper)
	listLayout(optList, Enum.FillDirection.Vertical, 0)

	local optBtns = {}
	for i, opt in ipairs(options) do
		local isSelected = opt == value
		local optBtn = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = isSelected and T.BadgeBg or T.RowBg,
			BorderSizePixel = 0, Text = opt,
			TextColor3 = isSelected and T.TextPrimary or T.TextMuted,
			Font = isSelected and Enum.Font.GothamMedium or Enum.Font.Gotham,
			TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 6, LayoutOrder = i,
		}, optList)
		padding(optBtn, 13)
		optBtns[opt] = optBtn

		optBtn.MouseButton1Click:Connect(function()
			value         = opt
			valLabel.Text = opt
			for o, b in pairs(optBtns) do
				b.BackgroundColor3 = o == opt and T.BadgeBg or T.RowBg
				b.TextColor3       = o == opt and T.TextPrimary or T.TextMuted
				b.Font             = o == opt and Enum.Font.GothamMedium or Enum.Font.Gotham
			end
			if callback then callback(value) end
		end)
	end

	make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "", ZIndex = 8,
	}, header).MouseButton1Click:Connect(function()
		open            = not open
		optList.Visible = open
		divider.Visible = open
	end)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.valBadge = valBadge
	entry.valLabel = valLabel
	entry.divider  = divider
	entry.optBtns  = optBtns
	entry.getValue = function() return value end

	local obj = {}
	function obj:SetValue(v)
		value = v
		valLabel.Text = v
		for o, b in pairs(optBtns) do
			b.BackgroundColor3 = o == v and T.BadgeBg or T.RowBg
			b.TextColor3       = o == v and T.TextPrimary or T.TextMuted
			b.Font             = o == v and Enum.Font.GothamMedium or Enum.Font.Gotham
		end
	end
	function obj:GetValue() return value end
	return obj
end

-- AddKeybind
function Tab:AddKeybind(name, desc, default, callback)
	local T       = self._window.Theme
	local key     = default or Enum.KeyCode.Unknown
	local binding = false
	local row     = self:_row(44)

	make("TextLabel", {
		Size = UDim2.new(1, -80, 0, 16), Position = UDim2.fromOffset(13, 8),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)
	make("TextLabel", {
		Size = UDim2.new(1, -80, 0, 14), Position = UDim2.fromOffset(13, 24),
		BackgroundTransparency = 1, Text = desc or "click badge to rebind",
		TextColor3 = T.TextMuted, Font = Enum.Font.Gotham, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	local badge = make("TextButton", {
		Size = UDim2.fromOffset(56, 24), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -13, 0.5, 0),
		BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0,
		Text = key.Name, TextColor3 = T.BadgeText,
		Font = Enum.Font.Code, TextSize = 11, ZIndex = 6,
	}, row)
	corner(badge, 4)
	stroke(badge, T.RowBorder)

	badge.MouseButton1Click:Connect(function()
		binding          = true
		badge.Text       = "..."
		badge.TextColor3 = T.TextPrimary
	end)
	UserInputService.InputBegan:Connect(function(input, gpe)
		if binding and input.UserInputType == Enum.UserInputType.Keyboard then
			binding          = false
			key              = input.KeyCode
			badge.Text       = key.Name
			badge.TextColor3 = self._window.Theme.BadgeText
			if callback then callback(key) end
		end
	end)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.type  = "keybind"
	entry.badge = badge

	local obj = {}
	function obj:GetKey() return key end
	return obj
end

-- AddTextInput
function Tab:AddTextInput(name, placeholder, callback)
	local T   = self._window.Theme
	local row = self:_row(60)

	make("TextLabel", {
		Size = UDim2.new(1, -26, 0, 16), Position = UDim2.fromOffset(13, 8),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	local field = make("TextBox", {
		Size = UDim2.new(1, -26, 0, 24), Position = UDim2.fromOffset(13, 28),
		BackgroundColor3 = T.PanelBg, BorderSizePixel = 0,
		PlaceholderText = placeholder or "", PlaceholderColor3 = T.TextMuted,
		Text = "", TextColor3 = T.TextPrimary,
		Font = Enum.Font.Gotham, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, ZIndex = 5,
	}, row)
	corner(field, 6)
	stroke(field, T.RowBorder)
	padding(field, 8, 8)

	field.FocusLost:Connect(function(enterPressed)
		if callback then callback(field.Text, enterPressed) end
	end)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.type  = "textinput"
	entry.field = field

	local obj = {}
	function obj:GetValue() return field.Text end
	function obj:SetValue(v) field.Text = v end
	return obj
end

-- AddColorPicker
function Tab:AddColorPicker(name, desc, swatches, default, callback)
	local T     = self._window.Theme
	local value = default or swatches[1]
	local row   = self:_row(44)

	make("TextLabel", {
		Size = UDim2.new(1, -140, 0, 16), Position = UDim2.fromOffset(13, 8),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)
	make("TextLabel", {
		Size = UDim2.new(1, -140, 0, 14), Position = UDim2.fromOffset(13, 24),
		BackgroundTransparency = 1, Text = desc or "", TextColor3 = T.TextMuted,
		Font = Enum.Font.Gotham, TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	local swatchFrame = make("Frame", {
		Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -13, 0.5, 0),
		BackgroundTransparency = 1, ZIndex = 5,
	}, row)
	make("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 5),
	}, swatchFrame)

	local swatchData = {}
	for _, color in ipairs(swatches) do
		local s = make("TextButton", {
			Size = UDim2.fromOffset(18, 18), BackgroundColor3 = color,
			BorderSizePixel = 0, Text = "", ZIndex = 6,
		}, swatchFrame)
		corner(s, 4)
		local st = stroke(s, color == value and T.TextPrimary or T.RowBorder,
			color == value and 1.5 or 0.5)
		swatchData[s] = { color = color, stroke = st }

		s.MouseButton1Click:Connect(function()
			value = color
			local t = self._window.Theme
			for btn, data in pairs(swatchData) do
				data.stroke.Color     = data.color == value and t.TextPrimary or t.RowBorder
				data.stroke.Thickness = data.color == value and 1.5 or 0.5
			end
			if callback then callback(value) end
		end)
	end

	local obj = {}
	function obj:GetValue() return value end
	function obj:SetValue(c)
		value = c
		local t = self._window.Theme
		for btn, data in pairs(swatchData) do
			data.stroke.Color     = data.color == c and t.TextPrimary or t.RowBorder
			data.stroke.Thickness = data.color == c and 1.5 or 0.5
		end
	end
	return obj
end

-- AddSearch
function Tab:AddSearch(placeholder, onChange)
	local T   = self._window.Theme
	local row = make("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = T.RowBg, BorderSizePixel = 0,
		ZIndex = 4, LayoutOrder = self:_order(),
	}, self.ContentFrame)
	corner(row)
	stroke(row, T.RowBorder)
	padding(row, 10, 10)
	table.insert(self._rows, { frame = row, type = "search" })

	make("TextLabel", {
		Size = UDim2.fromOffset(16, 34), BackgroundTransparency = 1,
		Text = "⌕", TextColor3 = T.TextMuted,
		Font = Enum.Font.GothamMedium, TextSize = 16, ZIndex = 5,
	}, row)

	local field = make("TextBox", {
		Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(24, 0),
		BackgroundTransparency = 1,
		PlaceholderText = placeholder or "search...",
		PlaceholderColor3 = T.TextMuted, Text = "",
		TextColor3 = T.TextPrimary, Font = Enum.Font.Gotham, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, ZIndex = 5,
	}, row)

	-- Register for theme updates
	local entry = self._rows[#self._rows]
	entry.field = field

	field:GetPropertyChangedSignal("Text"):Connect(function()
		if onChange then onChange(field.Text) end
	end)

	local obj = {}
	function obj:GetValue() return field.Text end
	function obj:Clear() field.Text = "" end
	return obj
end

-- ─────────────────────────────────────────
-- Tab:ApplyTheme  — recolors all registered rows
-- ─────────────────────────────────────────
function Tab:ApplyTheme(T)
	for _, entry in ipairs(self._rows) do
		local f = entry.frame
		local t = entry.type

		-- Every row frame background + border
		if f and f:IsA("Frame") and t ~= "separator" and t ~= "section" then
			f.BackgroundColor3 = T.RowBg
			local s = f:FindFirstChildOfClass("UIStroke")
			if s then s.Color = T.RowBorder end
		end

		if t == "separator" then
			f.BackgroundColor3 = T.RowBorder

		elseif t == "section" then
			f.TextColor3 = T.SectionTitle

		elseif t == "toggle" then
			-- Recolor text labels inside the row
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			-- Pill + knob recolored based on current value
			local on = entry.getValue()
			entry.pill.BackgroundColor3 = on and T.PillOn or T.PillOff
			entry.knob.BackgroundColor3 = on and T.KnobOn or T.KnobOff
			if entry.pillStroke then
				entry.pillStroke.Color = on and T.KnobOn or T.RowBorder
			end

		elseif t == "slider" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valBadge.TextColor3       = T.BadgeText
			entry.track.BackgroundColor3    = T.SliderTrack
			entry.fill.BackgroundColor3     = T.SliderFill
			entry.thumb.BackgroundColor3    = T.KnobOn
			local bs = entry.valBadge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "button" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.btn.BackgroundColor3 = T.BadgeBg
			entry.btn.TextColor3       = T.BadgeText
			local bs = entry.btn:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "keybind" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.badge.BackgroundColor3 = T.BadgeBg
			entry.badge.TextColor3       = T.BadgeText
			local bs = entry.badge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "dropdown" then
			for _, child in ipairs(f:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valLabel.TextColor3       = T.BadgeText
			entry.divider.BackgroundColor3  = T.RowBorder
			local cur = entry.getValue()
			for o, b in pairs(entry.optBtns) do
				b.BackgroundColor3 = o == cur and T.BadgeBg or T.RowBg
				b.TextColor3       = o == cur and T.TextPrimary or T.TextMuted
			end

		elseif t == "textinput" or t == "search" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = T.TextPrimary
				end
			end
			if entry.field then
				entry.field.TextColor3        = T.TextPrimary
				entry.field.PlaceholderColor3 = T.TextMuted
				if t == "textinput" then
					entry.field.BackgroundColor3 = T.PanelBg
				end
			end
		end
	end
end

