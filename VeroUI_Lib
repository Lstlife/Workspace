		Text                 = title:upper(),
		TextColor3           = T.SectionTitle,
		Font                 = Enum.Font.GothamMedium,
		TextSize             = 10,
		TextXAlignment       = Enum.TextXAlignment.Left,
		ZIndex               = 4,
		LayoutOrder          = self:_order(),
	}, self.ContentFrame)
	table.insert(self._rows, { frame = lbl, type = "section" })
end

