			TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 6, LayoutOrder = i,
		}, optList)
		padding(optBtn, 13)
		optBtns[opt] = optBtn

		optBtn.MouseButton1Click:Connect(function()
			value         = opt
			valLabel.Text = opt
			for o, b in pairs(optBtns) do
				b.BackgroundColor3 = o == opt and T.BadgeBg or T.RowBg
				b.TextColor3       = o == opt and T.TextPrimary or T.TextMuted
				b.Font             = o == opt and Enum.Font.GothamMedium or Enum.Font.Gotham
			end
			if callback then callback(value) end
		end)
	end

	make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "", ZIndex = 8,
	}, header).MouseButton1Click:Connect(function()
		open            = not open
		optList.Visible = open
		divider.Visible = open
	end)

	local entry = self._rows[#self._rows]
	entry.valBadge = valBadge
	entry.valLabel = valLabel
	entry.divider  = divider
	entry.optBtns  = optBtns
	entry.getValue = function() return value end

	local obj = {}
	function obj:SetValue(v)
		value = v
		valLabel.Text = v
		for o, b in pairs(optBtns) do
			b.BackgroundColor3 = o == v and T.BadgeBg or T.RowBg
			b.TextColor3       = o == v and T.TextPrimary or T.TextMuted
			b.Font             = o == v and Enum.Font.GothamMedium or Enum.Font.Gotham
		end
	end
	function obj:GetValue() return value end
	return obj
end

