		Name = "StatusBar", Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = T.StatusBar, BorderSizePixel = 0,
		ZIndex = 3, Visible = false,
	}, self.Window)
	stroke(self.StatusBar, T.BarBorder, 1)
	corner(self.StatusBar, 10)

	local statusInner = make("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 4,
	}, self.StatusBar)
	padding(statusInner, 14, 14)

