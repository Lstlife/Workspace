-- ─────────────────────────────────────────
-- AddGameBox
-- placeId    : number  — Roblox place ID
-- title      : string  — display name
-- buildFn    : function(panel) — called once when opened, panel is a Tab-like
--              object with all the same builders (AddToggle, AddSlider, etc.)
--              The panel frame is destroyed when the box is closed.
-- ─────────────────────────────────────────
function Tab:AddGameBox(placeId, title, buildFn)
	local T        = self._window.Theme
	local win      = self._window
	local isOpen      = false
	local activePanel   = nil  -- holds the live panel frame, nil when closed
	local activeDivider = nil  -- holds the divider, destroyed alongside panel
	-- Persistent state table — survives open/close cycles so toggles/sliders
	-- remember their values. Keys are set by the caller via state:set(key, val).
	-- buildFn receives this as its second argument.
	local state = {}
	state._data = {}
	function state:get(key, default)
		if self._data[key] == nil then
			return default
		end
		return self._data[key]
	end
	function state:set(key, value)
		self._data[key] = value
	end

	-- Thumbnail height constant — change this one value to resize
	local THUMB_H = 100

	-- Outer card frame — grows to contain panel when open
	local card = make("Frame", {
		Size             = UDim2.new(1, 0, 0, THUMB_H + 28),
		BackgroundColor3 = T.RowBg,
		BorderSizePixel  = 0,
		ClipsDescendants = false,
		ZIndex           = 4,
		LayoutOrder      = self:_order(),
		AutomaticSize    = Enum.AutomaticSize.Y,
	}, self.ContentFrame)
	corner(card)
	local cardStroke = stroke(card, T.RowBorder)
	table.insert(self._rows, { frame = card, type = "gamebox", cardStroke = cardStroke })

	-- Thumbnail area
	local thumbFrame = make("Frame", {
		Size             = UDim2.new(1, 0, 0, THUMB_H),
		BackgroundColor3 = T.RowBorder,
		BorderSizePixel  = 0,
		ZIndex           = 5,
		ClipsDescendants = true,
	}, card)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, thumbFrame)

	-- Thumbnail image (shown if fetch succeeds)
	local thumbImage = make("ImageLabel", {
		Size              = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image             = "",
		ScaleType         = Enum.ScaleType.Crop,
		ZIndex            = 6,
		Visible           = false,
	}, thumbFrame)

	-- Fallback / loading label
	local thumbLabel = make("TextLabel", {
		Size                 = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text                 = "loading...",
		TextColor3           = T.TextMuted,
		Font                 = Enum.Font.Gotham,
		TextSize             = 10,
		ZIndex               = 6,
	}, thumbFrame)

	-- Footer row: title + chevron
	local footer = make("Frame", {
		Size             = UDim2.new(1, 0, 0, 28),
		Position         = UDim2.fromOffset(0, THUMB_H),
		BackgroundTransparency = 1,
		ZIndex           = 5,
	}, card)

	make("TextLabel", {
		Size                 = UDim2.new(1, -32, 1, 0),
		Position             = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
		Text                 = title,
		TextColor3           = T.TextPrimary,
		Font                 = Enum.Font.GothamMedium,
		TextSize             = 12,
		TextXAlignment       = Enum.TextXAlignment.Left,
		ZIndex               = 6,
	}, footer)

	local chevron = make("TextLabel", {
		Size                 = UDim2.fromOffset(20, 28),
		AnchorPoint          = Vector2.new(1, 0),
		Position             = UDim2.new(1, -10, 0, 0),
		BackgroundTransparency = 1,
		Text                 = "›",
		TextColor3           = T.TextMuted,
		Font                 = Enum.Font.GothamMedium,
		TextSize             = 16,
		ZIndex               = 6,
	}, footer)

	-- ── Thumbnail fetch (async, graceful fallback) ──
	task.spawn(function()
		local success, err = pcall(function()
			thumbImage.Image = string.format(
				"rbxthumb://type=GameThumbnail&id=%d&w=768&h=432",
				placeId
			)

			thumbImage.Visible = true
			thumbLabel.Visible = false
		end)

		if not success then
			thumbLabel.Text = "preview failed"
			thumbLabel.TextColor3 = T.TextMuted
		end
	end)

	-- ── Open / close panel logic ──
	local function closePanel()
		if not isOpen then return end
		isOpen = false
		chevron.Text      = "›"
		chevron.TextColor3 = T.TextMuted
		cardStroke.Color  = T.RowBorder
		-- Destroy the panel frame entirely — clean slate next open
		if activePanel then
			activePanel:Destroy()
			activePanel = nil
		end
		if activeDivider then
			activeDivider:Destroy()
			activeDivider = nil
		end
		win:SetStatus("ready")
	end

	local function openPanel()
		if isOpen then return end
		isOpen = true
		chevron.Text       = "‹"
		chevron.TextColor3 = T.TextPrimary
		cardStroke.Color   = T.TextMuted

		-- Divider between footer and panel
		activeDivider = make("Frame", {
			Size             = UDim2.new(1, 0, 0, 1),
			Position         = UDim2.fromOffset(0, THUMB_H + 28),
			BackgroundColor3 = T.RowBorder,
			BorderSizePixel  = 0,
			ZIndex           = 5,
		}, card)

		-- Panel container — standard padding + list layout
		local panelFrame = make("Frame", {
			Size              = UDim2.new(1, 0, 0, 0),
			Position          = UDim2.fromOffset(0, THUMB_H + 29),
			BackgroundTransparency = 1,
			BorderSizePixel   = 0,
			AutomaticSize     = Enum.AutomaticSize.Y,
			ZIndex            = 5,
		}, card)
		padding(panelFrame, 12, 12, 10, 12)
		listLayout(panelFrame)
		activePanel = panelFrame

		-- Build a lightweight Tab-like proxy so buildFn uses familiar API
		-- It shares the same _window reference so themes + callbacks work
		local proxy = setmetatable({
			_window      = win,
			_layoutOrder = 0,
			_rows        = {},
			ContentFrame = panelFrame,
		}, Tab)

		-- Close button inside the panel
		local closeRow = make("Frame", {
			Size             = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			BorderSizePixel  = 0,
			ZIndex           = 6,
			LayoutOrder      = 999,
		}, panelFrame)

		local closeBtn = make("TextButton", {
			Size             = UDim2.fromOffset(60, 22),
			AnchorPoint      = Vector2.new(1, 0.5),
			Position         = UDim2.new(1, 0, 0.5, 0),
			BackgroundColor3 = T.BadgeBg,
			BorderSizePixel  = 0,
			Text             = "close",
			TextColor3       = T.BadgeText,
			Font             = Enum.Font.GothamMedium,
			TextSize         = 11,
			ZIndex           = 7,
		}, closeRow)
		corner(closeBtn, 6)
		stroke(closeBtn, T.RowBorder)
		closeBtn.MouseButton1Click:Connect(closePanel)

		-- Let the caller populate the panel
		-- state persists across open/close — use state:get(key, default) for
		-- component defaults and state:set(key, val) inside callbacks
		if buildFn then buildFn(proxy, state) end

		win:SetStatus(title:lower() .. " — game panel open")
	end

	-- Click anywhere on the card header (thumb + footer) toggles open/close
	local hitbox = make("TextButton", {
		Size                 = UDim2.new(1, 0, 0, THUMB_H + 28),
		BackgroundTransparency = 1,
		Text                 = "",
		ZIndex               = 8,
	}, card)
	hitbox.MouseButton1Click:Connect(function()
		if isOpen then closePanel() else openPanel() end
	end)
end

-- ─────────────────────────────────────────
-- Tab:ApplyTheme
-- ─────────────────────────────────────────
function Tab:ApplyTheme(T)
	for _, entry in ipairs(self._rows) do
		local f = entry.frame
		local t = entry.type

		if f and f:IsA("Frame") and t ~= "separator" and t ~= "section" and t ~= "gamebox" then
			f.BackgroundColor3 = T.RowBg
			local s = f:FindFirstChildOfClass("UIStroke")
			if s then s.Color = T.RowBorder end
		end

		if t == "separator" then
			f.BackgroundColor3 = T.RowBorder

		elseif t == "section" then
			f.TextColor3 = T.SectionTitle

		elseif t == "gamebox" then
			f.BackgroundColor3 = T.RowBg
			if entry.cardStroke then entry.cardStroke.Color = T.RowBorder end

		elseif t == "toggle" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			local on = entry.getValue()
			entry.pill.BackgroundColor3 = on and T.PillOn or T.PillOff
			entry.knob.BackgroundColor3 = on and T.KnobOn or T.KnobOff
			if entry.pillStroke then
				entry.pillStroke.Color = on and T.KnobOn or T.RowBorder
			end

		elseif t == "slider" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valBadge.TextColor3       = T.BadgeText
			entry.track.BackgroundColor3    = T.SliderTrack
			entry.fill.BackgroundColor3     = T.SliderFill
			entry.thumb.BackgroundColor3    = T.KnobOn
			local bs = entry.valBadge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "button" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.btn.BackgroundColor3 = T.BadgeBg
			entry.btn.TextColor3       = T.BadgeText
			local bs = entry.btn:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "keybind" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.badge.BackgroundColor3 = T.BadgeBg
			entry.badge.TextColor3       = T.BadgeText
			local bs = entry.badge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end

		elseif t == "dropdown" then
			for _, child in ipairs(f:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium
						and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valLabel.TextColor3       = T.BadgeText
			entry.divider.BackgroundColor3  = T.RowBorder
			local cur = entry.getValue()
			for o, b in pairs(entry.optBtns) do
				b.BackgroundColor3 = o == cur and T.BadgeBg or T.RowBg
				b.TextColor3       = o == cur and T.TextPrimary or T.TextMuted
			end

		elseif t == "textinput" or t == "search" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = T.TextPrimary
				end
			end
			if entry.field then
				entry.field.TextColor3        = T.TextPrimary
				entry.field.PlaceholderColor3 = T.TextMuted
				if t == "textinput" then
					entry.field.BackgroundColor3 = T.PanelBg
				end
			end
		end
	end
end

