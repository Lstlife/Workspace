	local obj = {}
	function obj:SetValue(v) value = v refresh() end
	function obj:GetValue() return value end
	return obj
end

-- AddSlider(name, min, max, default, callback)
-- callback(number) → returns { SetValue, GetValue, Reset }
function Tab:AddSlider(name, min, max, default, callback)
	local T        = self._window.Theme
	local defaultV = math.clamp(default or min, min, max)
	local value    = defaultV
	local row      = self:_row(54)

	make("TextLabel", {
		Size = UDim2.new(0.7, 0, 0, 16), Position = UDim2.new(0.03, 0, 0, 10),
		BackgroundTransparency = 1, Text = name, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, row)

	-- Value badge
	local valBadge = make("TextLabel", {
		Size = UDim2.fromOffset(44, 18), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.97, 0, 0, 8),
		BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0,
		Text = tostring(value), TextColor3 = T.BadgeText,
		Font = Enum.Font.GothamMedium, TextSize = 11, ZIndex = 5,
	}, row)
	corner(valBadge, 4)
	stroke(valBadge, T.RowBorder)

	-- Reset button — sits left of the value badge
	local resetBtn = make("ImageButton", {
		Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.97, -49, 0, 9),
		BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0,
		Image = "rbxassetid://99144149703689",
		ImageColor3 = Color3.fromRGB(163, 162, 165), ZIndex = 6,
	}, row)
	corner(resetBtn, 4)
	stroke(resetBtn, T.RowBorder)
	addHover(resetBtn, T.BadgeBg, T.BadgeHover)

	-- Slider track spans most of the row width
	local track = make("Frame", {
		Size = UDim2.new(0.88, 0, 0, 3), Position = UDim2.new(0.03, 0, 0, 40),
		BackgroundColor3 = T.SliderTrack, BorderSizePixel = 0, ZIndex = 5,
	}, row)
	corner(track, 2)

	local pct  = (value - min) / (max - min)
	local fill = make("Frame", {
		Size = UDim2.new(pct, 0, 1, 0),
		BackgroundColor3 = T.SliderFill, BorderSizePixel = 0, ZIndex = 6,
	}, track)
	corner(fill, 2)

	local thumb = make("Frame", {
		Size = UDim2.fromOffset(11, 11), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(pct, 0, 0.5, 0),
		BackgroundColor3 = T.KnobOn, BorderSizePixel = 0, ZIndex = 7,
	}, track)
	corner(thumb, 10)

	local function setSlider(v)
		value          = math.clamp(math.round(v), min, max)
		local p        = (value - min) / (max - min)
		tween(fill,  TW_FAST, { Size     = UDim2.new(p, 0, 1, 0) })
		tween(thumb, TW_FAST, { Position = UDim2.new(p, 0, 0.5, 0) })
		valBadge.Text  = tostring(value)
		if callback then callback(value) end
	end

	resetBtn.MouseButton1Click:Connect(function()
		tween(resetBtn, TW_FAST, { Rotation = 360 })
		task.delay(TW_FAST.Time, function() resetBtn.Rotation = 0 end)
		setSlider(defaultV)
	end)

	local dragging = false
	local hitbox = make("TextButton", {
		Size = UDim2.new(0.88, 0, 0, 20), Position = UDim2.new(0.03, 0, 0, 32),
		BackgroundTransparency = 1, Text = "", ZIndex = 8,
	}, row)
	hitbox.MouseButton1Down:Connect(function() dragging = true end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setSlider(min + rel * (max - min))
		end
	end)

	local entry = self._rows[#self._rows]
	entry.type     = "slider"
	entry.valBadge = valBadge
	entry.resetBtn = resetBtn
	entry.track    = track
	entry.fill     = fill
	entry.thumb    = thumb

	local obj = {}
	function obj:SetValue(v) setSlider(v) end
	function obj:GetValue() return value end
	function obj:Reset() setSlider(defaultV) end
	return obj
end

