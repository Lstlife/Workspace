		Size = UDim2.fromScale(0.025, 0.4), AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = T.StatusDot, BorderSizePixel = 0, ZIndex = 5,
	}, statusInner)
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, self.StatusDot)
	corner(self.StatusDot, 10)

	self.StatusLabel = make("TextLabel", {
		Size = UDim2.fromScale(0.5, 1), Position = UDim2.fromScale(0.04, 0),
		BackgroundTransparency = 1, Text = "ready",
		TextColor3 = T.StatusText, Font = Enum.Font.Gotham,
		TextSize = 0, TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
	}, statusInner)

	make("TextLabel", {
		Size = UDim2.fromScale(0.18, 1), Position = UDim2.fromScale(0.82, 0),
		BackgroundTransparency = 1, Text = "vero",
		TextColor3 = T.StatusText, Font = Enum.Font.GothamMedium,
		TextSize = 0, TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
	}, statusInner)

	local dragging, dragStart, startPos
	self.Bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true; dragStart = input.Position; startPos = self.Window.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local d = input.Position - dragStart
			self.Window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)

	self.MinimizeBtn.MouseButton1Click:Connect(function() self:Collapse() end)
	self.CloseBtn.MouseButton1Click:Connect(function() self.ScreenGui:Destroy() end)

	task.defer(function()
		local winW   = self.Window.AbsoluteSize.X
		local barH   = math.round(winW / 10.5)
		self._barH   = barH
		self.Bar.Size = UDim2.new(1, 0, 0, barH)
		-- _winScaleX is already correct, do not overwrite it here
		self.Window.Size = UDim2.new(self._winScaleX, 0, 0, barH)
		self.PanelBody.Position = UDim2.new(0, 0, 0, barH)
	end)

	self._settingsBuilt = false
	self.SettingsBtn.MouseButton1Click:Connect(function()
		if not self._settingsBuilt then
			self:_BuildSettingsTab()
			self._settingsBuilt = true
		end
		if self.ActiveTab == self._settingsTab then
			self:Collapse()
		else
			self:_SetActiveTab(self._settingsTab)
		end
	end)

	return self
end

-- ─────────────────────────────────────────
-- _BuildSettingsTab  (lazy, called on first ⚙ click)
-- ─────────────────────────────────────────
function VeroLib:_BuildSettingsTab()
	local tab = setmetatable({ _window = self, _layoutOrder = 0, _rows = {} }, Tab)
	tab.Name  = "Settings"

	local contentFrame = make("Frame", {
		Name = "SettingsContent", Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Visible = false, ZIndex = 3,
	}, self.PanelBody)
	listLayout(contentFrame, nil, 8)

	local dummyBtn = make("TextButton", {
		Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1,
		Text = "", Visible = false,
	}, self.Bar)
	tab.Button       = dummyBtn
	tab.Label        = make("TextLabel", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0) }, dummyBtn)
	tab.Underline    = make("Frame",     { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = false }, dummyBtn)
	tab.ContentFrame = contentFrame

	table.insert(self.Tabs, tab)
	self._settingsTab = tab

	tab:AddSection("theme")
	local themeKeys = {}
	for key in pairs(Themes) do table.insert(themeKeys, key) end
	table.sort(themeKeys)
	local currentThemeName = "DarkGrey"
	for key in pairs(Themes) do
		if self.Theme == Themes[key] then currentThemeName = key break end
	end
	tab:AddDropdown("theme", themeKeys, currentThemeName, function(selected)
		self:SetTheme(selected)
		self:SetStatus("theme: " .. selected:lower())
	end)

	tab:AddSection("keybinds")
	tab:AddKeybind("toggle menu", "show / hide vero", Enum.KeyCode.RightShift, function(key)
		self:BindToggleKey(key)
		self:SetStatus("toggle key: " .. key.Name)
	end)

	tab:AddSection("general")
	tab:AddToggle("always on top", "bar stays above game ui", true, function(v)
		self.ScreenGui.DisplayOrder = v and 10 or 0
	end)
	tab:AddToggle("notifications", "mod status changes", false, function(v)
		self._notificationsEnabled = v
	end)
	tab:AddSeparator()
	tab:AddButton("close vero", "destroy the ui entirely", "close", function()
		self.ScreenGui:Destroy()
	end)
end

-- ─────────────────────────────────────────
-- SetTheme  — tweens all surfaces to new palette
-- ─────────────────────────────────────────
function VeroLib:SetTheme(themeName)
	local T = Themes[themeName]
	if not T then return end
	self.Theme = T

	tween(self.Window,        TW_MED, { BackgroundColor3 = T.Background })
	tween(self.Bar,           TW_MED, { BackgroundColor3 = T.Bar })
	tween(self.PanelBody,     TW_MED, { BackgroundColor3 = T.PanelBg })
	tween(self.StatusBar,     TW_MED, { BackgroundColor3 = T.StatusBar })
	tween(self.StatusLabel,   TW_MED, { TextColor3 = T.StatusText })
	tween(self.StatusDot,     TW_MED, { BackgroundColor3 = T.StatusDot })
	tween(self._brandLabel,   TW_MED, { TextColor3 = T.BrandText })
	tween(self._outerDiamond, TW_MED, { BackgroundColor3 = T.LogoColor })
	tween(self._innerDiamond, TW_MED, { BackgroundColor3 = T.Bar })
	self.PanelBody.ScrollBarImageColor3 = T.RowBorder

	for _, b in ipairs(self._endFrame:GetChildren()) do
		if b:IsA("TextButton") then tween(b, TW_MED, { TextColor3 = T.EndBtn }) end
	end

	local winStroke = self.Window:FindFirstChildOfClass("UIStroke")
	if winStroke then tween(winStroke, TW_MED, { Color = T.BarBorder }) end
	local barStroke = self.Bar:FindFirstChildOfClass("UIStroke")
	if barStroke then tween(barStroke, TW_MED, { Color = T.BarBorder }) end
	local sbStroke = self.StatusBar:FindFirstChildOfClass("UIStroke")
	if sbStroke then tween(sbStroke, TW_MED, { Color = T.BarBorder }) end

	for _, t in ipairs(self.Tabs) do
		local active = (t == self.ActiveTab)
		tween(t.Button,    TW_MED, { BackgroundColor3 = active and T.TabActive or T.TabInactive })
		tween(t.Label,     TW_MED, { TextColor3 = active and T.TabText or T.TabTextMuted })
		tween(t.Underline, TW_MED, { BackgroundColor3 = T.TabUnderline })
		local ts = t.Button:FindFirstChildOfClass("UIStroke")
		if ts then tween(ts, TW_MED, { Color = T.BarBorder }) end
		if t.ApplyTheme then t:ApplyTheme(T) end
	end
end

-- ─────────────────────────────────────────
-- Expand / Collapse  — panel open/close
-- ─────────────────────────────────────────
function VeroLib:Expand(panelHeight)
	local barH = self._barH
	if not barH or barH <= 0 then
		barH = math.round(self.Window.AbsoluteSize.X / 10.5)
		self._barH = barH
	end

	local screenH = game:GetService("Workspace").CurrentCamera.ViewportSize.Y
	local maxPx   = math.floor(screenH * self.MaxPanelHeight)
	local clamped = math.min(panelHeight, maxPx)
	local sbH     = math.max(20, math.floor(barH * 0.55))
	local totalH  = barH + clamped + sbH

	-- Ensure bar and panel body are positioned correctly
	self.Bar.Size               = UDim2.new(1, 0, 0, barH)
	self.PanelBody.Position     = UDim2.new(0, 0, 0, barH)
	self.PanelBody.Size         = UDim2.new(1, 0, 0, clamped)
	self.PanelBody.Visible      = true
	self.StatusBar.Size         = UDim2.new(1, 0, 0, sbH)
	self.StatusBar.Visible      = true
	self.StatusBar.Position     = UDim2.new(0, 0, 0, barH + clamped)

	-- Window grows in pixel Y only — X stays as pure scale
	tween(self.Window, TW_MED, { Size = UDim2.new(self._winScaleX, 0, 0, totalH) })
	self.Expanded = true
end

function VeroLib:Collapse()
	local barH = self._barH
	if not barH or barH <= 0 then
		barH = math.round(self.Window.AbsoluteSize.X / 10.5)
		self._barH = barH
	end
	-- Collapse window back to just the bar height
	tween(self.Window, TW_MED, { Size = UDim2.new(self._winScaleX, 0, 0, barH) })
	task.delay(TW_MED.Time, function()
		self.PanelBody.Visible = false
		self.StatusBar.Visible = false
	end)
	self.Expanded  = false
	self.ActiveTab = nil
end

-- ─────────────────────────────────────────
-- AddTab  — adds a bar tab and content frame
-- ─────────────────────────────────────────
function VeroLib:AddTab(name)
	local T   = self.Theme
	local tab = setmetatable({ _window = self, _layoutOrder = 0, _rows = {} }, Tab)
	tab.Name  = name

	local tabBtn = make("TextButton", {
		Name = name .. "Tab",
		-- Each tab takes up space based on text; we use a minimum scale width
		-- relative to the TabContainer and let the label fill it with TextScaled
		Size = UDim2.fromScale(0, 1),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.TabInactive, BorderSizePixel = 0,
		Text = name:lower(),               -- text on the button drives AutomaticSize
		TextTransparency = 1,              -- invisible — label renders on top
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		ZIndex = 5, LayoutOrder = #self.Tabs + 1,
	}, self.TabContainer)
	stroke(tabBtn, T.BarBorder, 1)
	make("UIPadding", {
		PaddingLeft  = UDim.new(0, 18),
		PaddingRight = UDim.new(0, 18),
	}, tabBtn)
	-- Never let a tab collapse below a readable minimum
	make("UISizeConstraint", { MinSize = Vector2.new(50, 0) }, tabBtn)

	tabBtn.MouseEnter:Connect(function()
		if self.ActiveTab ~= tab then
			tween(tabBtn, TW_FAST, { BackgroundColor3 = T.TabHover })
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		if self.ActiveTab ~= tab then
			tween(tabBtn, TW_FAST, { BackgroundColor3 = T.TabInactive })
		end
	end)

	local tabLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = name:lower(), TextColor3 = T.TabTextMuted,
		Font = Enum.Font.Gotham, TextSize = 14,
		TextScaled = false, ZIndex = 6,
	}, tabBtn)

	local underline = make("Frame", {
		Size = UDim2.new(0, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = T.TabUnderline, BorderSizePixel = 0,
		Visible = false, ZIndex = 7,
	}, tabBtn)

	local contentFrame = make("Frame", {
		Name = name .. "Content", Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Visible = false, ZIndex = 3,
	}, self.PanelBody)
	listLayout(contentFrame, nil, 8)

	tab.Button       = tabBtn
	tab.Label        = tabLabel
	tab.Underline    = underline
	tab.ContentFrame = contentFrame

	tabBtn.MouseButton1Click:Connect(function()
		if self.ActiveTab == tab then self:Collapse() return end
		self:_SetActiveTab(tab)
	end)

	table.insert(self.Tabs, tab)
	return tab
end

-- ─────────────────────────────────────────
-- _SetActiveTab  (internal)
-- ─────────────────────────────────────────
function VeroLib:_SetActiveTab(tab)
	local T = self.Theme

	for _, t in ipairs(self.Tabs) do
		t.Button.BackgroundColor3 = T.TabInactive
		t.Label.TextColor3        = T.TabTextMuted
		t.Label.Font              = Enum.Font.Gotham
		t.Underline.Visible       = false
		t.Underline.Size          = UDim2.new(0, 0, 0, 2)
		t.ContentFrame.Visible    = false
	end

	tween(tab.Button, TW_FAST, { BackgroundColor3 = T.TabActive })
	tween(tab.Label,  TW_FAST, { TextColor3 = T.TabText })
	tab.Label.Font = Enum.Font.GothamMedium

	tab.Underline.Visible = true
	tab.Underline.Size    = UDim2.new(0, 0, 0, 2)
	tween(tab.Underline, TW_MED, { Size = UDim2.new(1, 0, 0, 2) })

	tab.ContentFrame.Visible = true
	self.ActiveTab = tab

	task.defer(function()
		local panelH = tab.ContentFrame.AbsoluteSize.Y + 24
		self:Expand(panelH)
	end)
end

-- ─────────────────────────────────────────
-- SetStatus / BindToggleKey
-- ─────────────────────────────────────────
function VeroLib:SetStatus(text)
	tween(self.StatusLabel, TW_FAST, { TextTransparency = 1 })
	task.delay(0.1, function()
		self.StatusLabel.Text = text
		tween(self.StatusLabel, TW_FAST, { TextTransparency = 0 })
	end)
end

function VeroLib:BindToggleKey(keyCode)
	keyCode = keyCode or Enum.KeyCode.RightShift
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == keyCode then
			self.ScreenGui.Enabled = not self.ScreenGui.Enabled
		end
	end)
end

return VeroLib
