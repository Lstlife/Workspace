	corner(knob, 10)

	local function refresh()
		local t = self._window.Theme
		tween(pill, TW_FAST, { BackgroundColor3 = value and t.PillOn or t.PillOff })
		tween(knob, TW_FAST, {
			BackgroundColor3 = value and t.KnobOn or t.KnobOff,
			Position         = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		})
		pillStroke.Color = value and t.KnobOn or t.RowBorder
	end

	make("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "", ZIndex = 7,
	}, row).MouseButton1Click:Connect(function()
		value = not value
		refresh()
		if callback then callback(value) end
	end)

	local entry = self._rows[#self._rows]
	entry.type       = "toggle"
	entry.pill       = pill
	entry.pillStroke = pillStroke
	entry.knob       = knob
