		Name = "TabContainer", Size = UDim2.new(1, -161, 1, 0),
		Position = UDim2.fromOffset(86, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		ZIndex = 5, ClipsDescendants = true,
	}, self.Bar)
