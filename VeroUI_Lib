-- AddSearch(placeholder, onChange?)
-- Filters all rows in the tab by text content as user types.
-- onChange(query) fires on each keystroke → returns { GetValue, Clear }
function Tab:AddSearch(placeholder, onChange)
	local T   = self._window.Theme
	local row = make("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = T.RowBg, BorderSizePixel = 0,
		ZIndex = 4, LayoutOrder = self:_order(),
	}, self.ContentFrame)
	corner(row, 8)
	local rowStroke = stroke(row, T.RowBorder)
	padding(row, 10, 10)
	table.insert(self._rows, { frame = row, type = "search" })

	make("ImageButton", {
		Position = UDim2.fromOffset(0, 9),
		Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
		Image = "rbxassetid://131786185512555",
		ImageColor3 = Color3.fromRGB(123, 123, 125), ZIndex = 5,
	}, row)

	local field = make("TextBox", {
		Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(24, 0),
		BackgroundTransparency = 1,
		PlaceholderText = placeholder or "search...",
		PlaceholderColor3 = T.TextMuted, Text = "",
		TextColor3 = T.TextPrimary, Font = Enum.Font.Gotham, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, ZIndex = 5,
	}, row)

	field.Focused:Connect(function()
		tween(row, TW_FAST, { BackgroundColor3 = T.RowHover })
		rowStroke.Color = T.TextMuted
	end)
	field.FocusLost:Connect(function()
		tween(row, TW_FAST, { BackgroundColor3 = T.RowBg })
		rowStroke.Color = T.RowBorder
	end)

	local function getFrameText(frame)
		local parts = {}
		for _, desc in ipairs(frame:GetDescendants()) do
			if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text ~= "" then
				table.insert(parts, desc.Text:lower())
			end
		end
		return table.concat(parts, " ")
	end

	local function applyFilter(query)
		query = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
		for _, child in ipairs(self.ContentFrame:GetChildren()) do
			if child == row or child:IsA("UIListLayout") or child:IsA("UIPadding") then
				continue
			end
			if query == "" then
				child.Visible = true
			else
				local text = getFrameText(child)
				if child:IsA("TextLabel") then text = text .. " " .. child.Text:lower() end
				child.Visible = text:find(query, 1, true) ~= nil
			end
		end
		if onChange then onChange(query) end
	end

	field:GetPropertyChangedSignal("Text"):Connect(function()
		applyFilter(field.Text)
	end)

	local entry = self._rows[#self._rows]
	entry.field = field

	local obj = {}
	function obj:GetValue() return field.Text end
	function obj:Clear() field.Text = "" applyFilter("") end
	return obj
end

-- ─────────────────────────────────────────
-- AddGameBox(placeId, title, buildFn)
--   buildFn(panel, state) — panel has all Tab builders
--   state:get(key, default) / state:set(key, value) persist across open/close
-- ─────────────────────────────────────────
function Tab:AddGameBox(placeId, title, buildFn)
	local T             = self._window.Theme
	local win           = self._window
	local isOpen        = false
	local activePanel   = nil
	local activeDivider = nil

	-- Persistent state — survives open/close cycles
	local state = { _data = {} }
	function state:get(key, default)
		return self._data[key] == nil and default or self._data[key]
	end
	function state:set(key, value)
		self._data[key] = value
	end

	local THUMB_H = 100

	local card = make("Frame", {
		Size = UDim2.new(1, 0, 0, THUMB_H + 28),
		BackgroundColor3 = T.RowBg, BorderSizePixel = 0,
		ClipsDescendants = false, ZIndex = 4,
		LayoutOrder = self:_order(), AutomaticSize = Enum.AutomaticSize.Y,
	}, self.ContentFrame)
	corner(card, 8)
	local cardStroke = stroke(card, T.RowBorder)
	table.insert(self._rows, { frame = card, type = "gamebox", cardStroke = cardStroke })

	-- Thumbnail
	local thumbFrame = make("Frame", {
		Size = UDim2.new(1, 0, 0, THUMB_H),
		BackgroundColor3 = T.RowBorder, BorderSizePixel = 0,
		ZIndex = 5, ClipsDescendants = true,
	}, card)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, thumbFrame)

	local thumbImage = make("ImageLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Image = "", ScaleType = Enum.ScaleType.Crop, ZIndex = 6, Visible = false,
	}, thumbFrame)

	local thumbLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "loading...", TextColor3 = T.TextMuted,
		Font = Enum.Font.Gotham, TextSize = 10, ZIndex = 6,
	}, thumbFrame)

	-- Footer row: title + chevron
	local footer = make("Frame", {
		Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, THUMB_H),
		BackgroundTransparency = 1, ZIndex = 5,
	}, card)

	make("TextLabel", {
		Size = UDim2.new(1, -32, 1, 0), Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1, Text = title, TextColor3 = T.TextPrimary,
		Font = Enum.Font.GothamMedium, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	}, footer)

	local chevronFrame = make("Frame", {
		Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		BackgroundTransparency = 1, ZIndex = 6,
	}, footer)
	local chevronLabel = make("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		Text = "›", TextColor3 = T.TextMuted,
		Font = Enum.Font.GothamMedium, TextSize = 16, ZIndex = 7,
	}, chevronFrame)

	-- Card hover (only when closed so open state doesn't reset)
	card.MouseEnter:Connect(function()
		tween(card, TW_FAST, { BackgroundColor3 = T.RowHover })
	end)
	card.MouseLeave:Connect(function()
		if not isOpen then tween(card, TW_FAST, { BackgroundColor3 = T.RowBg }) end
	end)

	-- Async thumbnail fetch with fade-in
	task.spawn(function()
		local ok = pcall(function()
			thumbImage.Image = ("rbxthumb://type=GameThumbnail&id=%d&w=768&h=432"):format(placeId)
			thumbImage.ImageTransparency = 1
			thumbImage.Visible = true
			thumbLabel.Visible = false
			tween(thumbImage, TW_MED, { ImageTransparency = 0 })
		end)
		if not ok then thumbLabel.Text = "preview failed" end
	end)

	local function closePanel()
		if not isOpen then return end
		isOpen = false
		tween(chevronLabel, TW_FAST, { Rotation = 0, TextColor3 = T.TextMuted })
		tween(cardStroke,   TW_FAST, { Color = T.RowBorder })
		tween(card,         TW_FAST, { BackgroundColor3 = T.RowBg })
		if activePanel   then activePanel:Destroy();   activePanel   = nil end
		if activeDivider then activeDivider:Destroy(); activeDivider = nil end
		win:SetStatus("ready")
	end

	local function openPanel()
		if isOpen then return end
		isOpen = true
		tween(chevronLabel, TW_FAST,		{ Rotation = 90, TextColor3 = T.TextPrimary })
		tween(cardStroke, TW_FAST, { Color = T.TextMuted })

		activeDivider = make("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			Position = UDim2.fromOffset(0, THUMB_H + 28),
			BackgroundColor3 = T.RowBorder, BorderSizePixel = 0, ZIndex = 5,
		}, card)

		local panelFrame = make("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			Position = UDim2.fromOffset(0, THUMB_H + 29),
			BackgroundColor3 = T.PanelBg, BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 5,
		}, card)
		padding(panelFrame, 12, 12, 10, 12)
		listLayout(panelFrame, nil, 8)
		activePanel = panelFrame

		-- Panel proxy — full Tab API
		local proxy = setmetatable({
			_window = win, _layoutOrder = 0, _rows = {}, ContentFrame = panelFrame,
		}, Tab)

		-- Close button at the bottom of the panel
		local closeRow = make("Frame", {
			Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1,
			BorderSizePixel = 0, ZIndex = 6, LayoutOrder = 999,
		}, panelFrame)

		local closeBtn = make("TextButton", {
			Size = UDim2.fromOffset(60, 22), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			BackgroundColor3 = T.BadgeBg, BorderSizePixel = 0,
			Text = "close", TextColor3 = T.BadgeText,
			Font = Enum.Font.GothamMedium, TextSize = 11, ZIndex = 7,
		}, closeRow)
		corner(closeBtn, 6)
		stroke(closeBtn, T.RowBorder)
		addHover(closeBtn, T.BadgeBg, T.BadgeHover)
		closeBtn.MouseButton1Click:Connect(closePanel)

		if buildFn then buildFn(proxy, state) end
		win:SetStatus(title:lower() .. " — game panel open")
	end

	-- Clickable hitbox covering thumb + footer
	local hitbox = make("TextButton", {
		Size = UDim2.new(1, 0, 0, THUMB_H + 28),
		BackgroundTransparency = 1, Text = "", ZIndex = 8,
	}, card)
	hitbox.MouseButton1Click:Connect(function()
		if isOpen then closePanel() else openPanel() end
	end)
end

-- ─────────────────────────────────────────
-- Tab:ApplyTheme  (internal — called by SetTheme)
-- ─────────────────────────────────────────
function Tab:ApplyTheme(T)
	for _, entry in ipairs(self._rows) do
		local f = entry.frame
		local t = entry.type

		if f and f:IsA("Frame") and t ~= "separator" and t ~= "section" and t ~= "gamebox" then
			f.BackgroundColor3 = T.RowBg
			f.MouseEnter:Connect(function() tween(f, TW_FAST, { BackgroundColor3 = T.RowHover }) end)
			f.MouseLeave:Connect(function() tween(f, TW_FAST, { BackgroundColor3 = T.RowBg }) end)
			local s = f:FindFirstChildOfClass("UIStroke")
			if s then s.Color = T.RowBorder end
		end

		if t == "separator" then
			f.BackgroundColor3 = T.RowBorder
		elseif t == "section" then
			f.TextColor3 = T.SectionTitle
		elseif t == "gamebox" then
			f.BackgroundColor3 = T.RowBg
			if entry.cardStroke then entry.cardStroke.Color = T.RowBorder end
		elseif t == "toggle" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium and T.TextPrimary or T.TextMuted
				end
			end
			local on = entry.getValue()
			entry.pill.BackgroundColor3 = on and T.PillOn or T.PillOff
			entry.knob.BackgroundColor3 = on and T.KnobOn or T.KnobOff
			if entry.pillStroke then entry.pillStroke.Color = on and T.KnobOn or T.RowBorder end
		elseif t == "slider" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valBadge.TextColor3       = T.BadgeText
			entry.track.BackgroundColor3    = T.SliderTrack
			entry.fill.BackgroundColor3     = T.SliderFill
			entry.thumb.BackgroundColor3    = T.KnobOn
			if entry.resetBtn then
				entry.resetBtn.BackgroundColor3 = T.BadgeBg
				local rs = entry.resetBtn:FindFirstChildOfClass("UIStroke")
				if rs then rs.Color = T.RowBorder end
			end
			local bs = entry.valBadge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end
		elseif t == "button" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium and T.TextPrimary or T.TextMuted
				end
			end
			entry.btn.BackgroundColor3 = T.BadgeBg
			entry.btn.TextColor3       = T.BadgeText
			local bs = entry.btn:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end
		elseif t == "keybind" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium and T.TextPrimary or T.TextMuted
				end
			end
			entry.badge.BackgroundColor3 = T.BadgeBg
			entry.badge.TextColor3       = T.BadgeText
			local bs = entry.badge:FindFirstChildOfClass("UIStroke")
			if bs then bs.Color = T.RowBorder end
		elseif t == "dropdown" then
			for _, child in ipairs(f:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = child.Font == Enum.Font.GothamMedium and T.TextPrimary or T.TextMuted
				end
			end
			entry.valBadge.BackgroundColor3 = T.BadgeBg
			entry.valLabel.TextColor3       = T.BadgeText
			entry.divider.BackgroundColor3  = T.RowBorder
			local cur = entry.getValue()
			for o, b in pairs(entry.optBtns) do
				b.BackgroundColor3 = o == cur and T.BadgeBg or T.RowBg
				b.TextColor3       = o == cur and T.TextPrimary or T.TextMuted
			end
		elseif t == "textinput" or t == "search" then
			for _, child in ipairs(f:GetChildren()) do
				if child:IsA("TextLabel") then child.TextColor3 = T.TextPrimary end
			end
			if entry.field then
				entry.field.TextColor3        = T.TextPrimary
				entry.field.PlaceholderColor3 = T.TextMuted
				if t == "textinput" then entry.field.BackgroundColor3 = T.PanelBg end
			end
		end
	end
end

